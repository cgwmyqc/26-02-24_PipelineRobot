<?xml version="1.0"?>
<package format="3">
  <name>ui_call_sh</name>
  <version>0.1.0</version>
  <description>ROS2 node that executes a local whitelisted shell script based on UI topic commands.</description>

  <maintainer email="dev@example.com">PipelineRobot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ament_index_python</depend>
  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
