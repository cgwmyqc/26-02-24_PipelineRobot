root = true

[*.{c,cc,cpp,cxx,h,hpp,ino}]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 2

[*.{sh,bash}]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[Dockerfile*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.{yml,yaml,launch,xml,json}]
charset = utf-8
end_of_line = lf
insert_final_newline = true
