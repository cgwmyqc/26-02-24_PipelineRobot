<launch>
  <arg name="video_url" default="rtsp://test:hitzri123@192.168.1.64:554/Streaming/Channels/101" />
  <arg name="camera_info_url" default="package://project_bringup/config/hik_camera_info.yaml" />
  <arg name="frame_id" default="camera_link" />

  <node pkg="ipcamera_driver" type="ipcamera_driver" name="mrl_ip_camera" output="screen">
    <param name="video_url" type="string" value="$(arg video_url)" />
    <param name="camera_info_url" type="string" value="$(arg camera_info_url)" />
    <param name="frame_id" type="string" value="$(arg frame_id)" />
    <remap from="camera/image" to="/camera/image" />
    <remap from="camera/camera_info" to="/camera/camera_info" />
  </node>
</launch>
